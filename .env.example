# Telegram API credentials (get them from https://my.telegram.org)
API_ID=123456
API_HASH=your_api_hash_here

# Target Telegram group name or username (forum topics must be enabled)
MONITOR_GROUP=Anime List

# Scanning interval in seconds (default: 300 seconds)
CHECK_INTERVAL=300

# SQLite database file path
DATABASE_PATH=db/anime_tracker.db
